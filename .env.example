APP_ENV=local
SECRET_KEY=change-this-secret-before-production
PUBLIC_ORIGIN=http://localhost:3000
TUNEAI_DOMAIN=localhost
DATABASE_URL=postgresql+psycopg://tuneai:tuneai@postgres:5432/tuneai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
EMBED_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
DEMO_BOOTSTRAP_ENABLED=true
DEMO_BOOTSTRAP_LIMIT_PER_HOUR=30
DEMO_BOOTSTRAP_TTL_HOURS=24
MOODLE_INTEGRATION_ENABLED=false
MOODLE_INTEGRATION_TOKEN=
MOODLE_INTEGRATION_SITE_ID=tuneai-moodle-local
MOODLE_INTEGRATION_OWNER_EMAILS=
MOODLE_HOST_PORT=18080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=moodle-admin-password
MOODLE_ADMIN_EMAIL=admin@example.edu
MOODLE_SITE_NAME=TuneAI Moodle
MOODLE_POSTGRES_PASSWORD=moodle

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
POSTGRES_PASSWORD=tuneai
RABBITMQ_PASSWORD=tuneai
MINIO_ROOT_PASSWORD=minioadmin
QUEUE_NAME=tuneai.answer.uploaded

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=tuneai-audio
S3_REGION=us-east-1

YANDEX_MOCK=true
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_USE_METADATA_IAM=false
YANDEX_METADATA_URL=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
YANDEX_GPT_MODEL_URI=gpt://<folder_ID>/yandexgpt-5.1
YANDEX_LITE_MODEL_URI=gpt://<folder_ID>/yandexgpt-5-lite
YANDEX_EMBED_DOC_URI=emb://<folder_ID>/text-search-doc/latest
YANDEX_EMBED_QUERY_URI=emb://<folder_ID>/text-search-query/latest
YANDEX_COMPLETION_URL=https://ai.api.cloud.yandex.net/foundationModels/v1/completion
YANDEX_EMBEDDING_URL=https://ai.api.cloud.yandex.net/foundationModels/v1/textEmbedding
SPEECHKIT_RECOGNIZE_URL=https://stt.api.cloud.yandex.net/stt/v3/recognizeFileAsync
SPEECHKIT_OPERATION_URL=https://operation.api.cloud.yandex.net/operations
SPEECHKIT_RESULT_URL=https://stt.api.cloud.yandex.net/stt/v3/getRecognition
YANDEX_DATA_LOGGING_ENABLED=false
REVIEW_CONFIDENCE_THRESHOLD=0.75
RUNTIME_AI_PROVIDER_CONFIG_ENABLED=true
TEST_CREATOR_ROLES=student,methodist,teacher,interviewer,admin
ANSWER_REVIEWER_ROLES=teacher,interviewer,admin

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_TUNEAI_TEMPLATE=unconfigured
NEXT_PUBLIC_TUNEAI_PRODUCT_NAME=
NEXT_PUBLIC_TUNEAI_LOGO_TEXT=
NEXT_PUBLIC_TUNEAI_LOGO_URL=
NEXT_PUBLIC_TUNEAI_REPOSITORY_URL=https://github.com/CRUDoshleps/TuneAI
NEXT_PUBLIC_TUNEAI_DOCS_URL=https://github.com/CRUDoshleps/TuneAI
NEXT_PUBLIC_TUNEAI_CONSULTATION_EMAIL=
NEXT_PUBLIC_TUNEAI_CONSULTATION_PERSON=
NEXT_PUBLIC_TUNEAI_BACKGROUND_COLOR=
NEXT_PUBLIC_TUNEAI_SURFACE_COLOR=
NEXT_PUBLIC_TUNEAI_PANEL_COLOR=
NEXT_PUBLIC_TUNEAI_PANEL_SOFT_COLOR=
NEXT_PUBLIC_TUNEAI_TEXT_COLOR=
NEXT_PUBLIC_TUNEAI_MUTED_COLOR=
NEXT_PUBLIC_TUNEAI_LINE_COLOR=
NEXT_PUBLIC_TUNEAI_ACCENT_COLOR=
NEXT_PUBLIC_TUNEAI_ACCENT_SOFT_COLOR=
NEXT_PUBLIC_TUNEAI_DANGER_COLOR=
NEXT_PUBLIC_TUNEAI_WARNING_COLOR=
NEXT_PUBLIC_TUNEAI_SUCCESS_COLOR=
NEXT_PUBLIC_TUNEAI_EMBED_ALLOWED_ORIGINS=
NEXT_PUBLIC_TUNEAI_CONFIG_JSON=
