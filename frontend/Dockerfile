FROM node:26-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019 AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL=/api
ARG NEXT_PUBLIC_TUNEAI_TEMPLATE=unconfigured
ARG NEXT_PUBLIC_TUNEAI_PRODUCT_NAME=
ARG NEXT_PUBLIC_TUNEAI_LOGO_TEXT=
ARG NEXT_PUBLIC_TUNEAI_LOGO_URL=
ARG NEXT_PUBLIC_TUNEAI_REPOSITORY_URL=https://github.com/CRUDoshleps/TuneAI
ARG NEXT_PUBLIC_TUNEAI_DOCS_URL=https://github.com/CRUDoshleps/TuneAI
ARG NEXT_PUBLIC_TUNEAI_CONSULTATION_EMAIL=
ARG NEXT_PUBLIC_TUNEAI_CONSULTATION_PERSON=
ARG NEXT_PUBLIC_TUNEAI_BACKGROUND_COLOR=
ARG NEXT_PUBLIC_TUNEAI_SURFACE_COLOR=
ARG NEXT_PUBLIC_TUNEAI_PANEL_COLOR=
ARG NEXT_PUBLIC_TUNEAI_PANEL_SOFT_COLOR=
ARG NEXT_PUBLIC_TUNEAI_TEXT_COLOR=
ARG NEXT_PUBLIC_TUNEAI_MUTED_COLOR=
ARG NEXT_PUBLIC_TUNEAI_LINE_COLOR=
ARG NEXT_PUBLIC_TUNEAI_ACCENT_COLOR=
ARG NEXT_PUBLIC_TUNEAI_ACCENT_SOFT_COLOR=
ARG NEXT_PUBLIC_TUNEAI_DANGER_COLOR=
ARG NEXT_PUBLIC_TUNEAI_WARNING_COLOR=
ARG NEXT_PUBLIC_TUNEAI_SUCCESS_COLOR=
ARG NEXT_PUBLIC_TUNEAI_EMBED_ALLOWED_ORIGINS=
ARG NEXT_PUBLIC_TUNEAI_CONFIG_JSON=
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_TUNEAI_TEMPLATE=${NEXT_PUBLIC_TUNEAI_TEMPLATE}
ENV NEXT_PUBLIC_TUNEAI_PRODUCT_NAME=${NEXT_PUBLIC_TUNEAI_PRODUCT_NAME}
ENV NEXT_PUBLIC_TUNEAI_LOGO_TEXT=${NEXT_PUBLIC_TUNEAI_LOGO_TEXT}
ENV NEXT_PUBLIC_TUNEAI_LOGO_URL=${NEXT_PUBLIC_TUNEAI_LOGO_URL}
ENV NEXT_PUBLIC_TUNEAI_REPOSITORY_URL=${NEXT_PUBLIC_TUNEAI_REPOSITORY_URL}
ENV NEXT_PUBLIC_TUNEAI_DOCS_URL=${NEXT_PUBLIC_TUNEAI_DOCS_URL}
ENV NEXT_PUBLIC_TUNEAI_CONSULTATION_EMAIL=${NEXT_PUBLIC_TUNEAI_CONSULTATION_EMAIL}
ENV NEXT_PUBLIC_TUNEAI_CONSULTATION_PERSON=${NEXT_PUBLIC_TUNEAI_CONSULTATION_PERSON}
ENV NEXT_PUBLIC_TUNEAI_BACKGROUND_COLOR=${NEXT_PUBLIC_TUNEAI_BACKGROUND_COLOR}
ENV NEXT_PUBLIC_TUNEAI_SURFACE_COLOR=${NEXT_PUBLIC_TUNEAI_SURFACE_COLOR}
ENV NEXT_PUBLIC_TUNEAI_PANEL_COLOR=${NEXT_PUBLIC_TUNEAI_PANEL_COLOR}
ENV NEXT_PUBLIC_TUNEAI_PANEL_SOFT_COLOR=${NEXT_PUBLIC_TUNEAI_PANEL_SOFT_COLOR}
ENV NEXT_PUBLIC_TUNEAI_TEXT_COLOR=${NEXT_PUBLIC_TUNEAI_TEXT_COLOR}
ENV NEXT_PUBLIC_TUNEAI_MUTED_COLOR=${NEXT_PUBLIC_TUNEAI_MUTED_COLOR}
ENV NEXT_PUBLIC_TUNEAI_LINE_COLOR=${NEXT_PUBLIC_TUNEAI_LINE_COLOR}
ENV NEXT_PUBLIC_TUNEAI_ACCENT_COLOR=${NEXT_PUBLIC_TUNEAI_ACCENT_COLOR}
ENV NEXT_PUBLIC_TUNEAI_ACCENT_SOFT_COLOR=${NEXT_PUBLIC_TUNEAI_ACCENT_SOFT_COLOR}
ENV NEXT_PUBLIC_TUNEAI_DANGER_COLOR=${NEXT_PUBLIC_TUNEAI_DANGER_COLOR}
ENV NEXT_PUBLIC_TUNEAI_WARNING_COLOR=${NEXT_PUBLIC_TUNEAI_WARNING_COLOR}
ENV NEXT_PUBLIC_TUNEAI_SUCCESS_COLOR=${NEXT_PUBLIC_TUNEAI_SUCCESS_COLOR}
ENV NEXT_PUBLIC_TUNEAI_EMBED_ALLOWED_ORIGINS=${NEXT_PUBLIC_TUNEAI_EMBED_ALLOWED_ORIGINS}
ENV NEXT_PUBLIC_TUNEAI_CONFIG_JSON=${NEXT_PUBLIC_TUNEAI_CONFIG_JSON}
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM node:26-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019 AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
RUN addgroup -S -g 10001 tuneai \
    && adduser -S -u 10001 -G tuneai tuneai
COPY --from=builder --chown=tuneai:tuneai /app/.next/standalone ./
COPY --from=builder --chown=tuneai:tuneai /app/.next/static ./.next/static
COPY --from=builder --chown=tuneai:tuneai /app/public ./public
EXPOSE 3000
USER tuneai
CMD ["node", "server.js"]
