FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL=/api
ARG NEXT_PUBLIC_TUNEAI_PRODUCT_NAME=TuneAI
ARG NEXT_PUBLIC_TUNEAI_LOGO_TEXT=TuneAI
ARG NEXT_PUBLIC_TUNEAI_LOGO_URL=
ARG NEXT_PUBLIC_TUNEAI_REPOSITORY_URL=https://github.com/CRUDoshleps/TuneAI
ARG NEXT_PUBLIC_TUNEAI_DOCS_URL=https://github.com/CRUDoshleps/TuneAI
ARG NEXT_PUBLIC_TUNEAI_CONSULTATION_EMAIL=
ARG NEXT_PUBLIC_TUNEAI_CONSULTATION_PERSON=
ARG NEXT_PUBLIC_TUNEAI_CONFIG_JSON=
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_TUNEAI_PRODUCT_NAME=${NEXT_PUBLIC_TUNEAI_PRODUCT_NAME}
ENV NEXT_PUBLIC_TUNEAI_LOGO_TEXT=${NEXT_PUBLIC_TUNEAI_LOGO_TEXT}
ENV NEXT_PUBLIC_TUNEAI_LOGO_URL=${NEXT_PUBLIC_TUNEAI_LOGO_URL}
ENV NEXT_PUBLIC_TUNEAI_REPOSITORY_URL=${NEXT_PUBLIC_TUNEAI_REPOSITORY_URL}
ENV NEXT_PUBLIC_TUNEAI_DOCS_URL=${NEXT_PUBLIC_TUNEAI_DOCS_URL}
ENV NEXT_PUBLIC_TUNEAI_CONSULTATION_EMAIL=${NEXT_PUBLIC_TUNEAI_CONSULTATION_EMAIL}
ENV NEXT_PUBLIC_TUNEAI_CONSULTATION_PERSON=${NEXT_PUBLIC_TUNEAI_CONSULTATION_PERSON}
ENV NEXT_PUBLIC_TUNEAI_CONFIG_JSON=${NEXT_PUBLIC_TUNEAI_CONFIG_JSON}
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
RUN addgroup -S -g 10001 tuneai \
    && adduser -S -u 10001 -G tuneai tuneai
COPY --from=builder --chown=tuneai:tuneai /app/.next/standalone ./
COPY --from=builder --chown=tuneai:tuneai /app/.next/static ./.next/static
COPY --from=builder --chown=tuneai:tuneai /app/public ./public
EXPOSE 3000
USER tuneai
CMD ["node", "server.js"]
