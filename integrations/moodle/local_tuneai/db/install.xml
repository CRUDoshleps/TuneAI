<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/tuneai/db" VERSION="2026082302" COMMENT="TuneAI Moodle integration tables">
  <TABLES>
    <TABLE NAME="local_tuneai_map" COMMENT="Mapping between Moodle questions and TuneAI questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="tuneai_test_id" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="tuneai_question_id" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="question_text" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="methodist_email" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="answer_mode" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="both"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_cmid_question_group" UNIQUE="true" FIELDS="courseid, cmid, questionid, groupid"/>
        <INDEX NAME="tuneai_test_question" UNIQUE="false" FIELDS="tuneai_test_id, tuneai_question_id"/>
        <INDEX NAME="methodist_email" UNIQUE="false" FIELDS="methodist_email"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_tuneai_submission" COMMENT="TuneAI submission status mirrored in Moodle">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="external_submission_id" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="questionattemptid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="tuneai_test_id" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="tuneai_question_id" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="tuneai_attempt_id" TYPE="char" LENGTH="36" NOTNULL="false"/>
        <FIELD NAME="tuneai_answer_id" TYPE="char" LENGTH="36" NOTNULL="false"/>
        <FIELD NAME="answer_status" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="result_ready" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="score" TYPE="number" LENGTH="10" DECIMALS="4" NOTNULL="false"/>
        <FIELD NAME="max_score" TYPE="number" LENGTH="10" DECIMALS="4" NOTNULL="false"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" DECIMALS="4" NOTNULL="false"/>
        <FIELD NAME="teacher_signal" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="feedback" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="confidence" TYPE="number" LENGTH="10" DECIMALS="6" NOTNULL="false"/>
        <FIELD NAME="review_reason" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="transcript" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="sync_attempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="next_sync_time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="last_error" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="external_submission_id" UNIQUE="true" FIELDS="external_submission_id"/>
        <INDEX NAME="course_cmid_user" UNIQUE="false" FIELDS="courseid, cmid, userid"/>
        <INDEX NAME="result_ready" UNIQUE="false" FIELDS="result_ready"/>
        <INDEX NAME="next_sync_time" UNIQUE="false" FIELDS="next_sync_time"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
