[Unit]
Description=Fetch TuneAI secrets from Yandex Lockbox
After=network-online.target docker.service
Wants=network-online.target
Before=tuneai.service
After=systemd-tmpfiles-setup.service

[Service]
Type=oneshot
EnvironmentFile=/srv/apps/tuneai/deploy/.env.production
ExecStart=/srv/apps/tuneai/deploy/fetch-secrets.sh
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/apps/tuneai

[Install]
WantedBy=multi-user.target
